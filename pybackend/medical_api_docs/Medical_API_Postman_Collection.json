                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 500]);",
                  "});",
                  "",
                  "pm.test(\"Response has brain_tumor or breast_cancer task\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect(jsonData.task).to.be.oneOf(['breast_cancer']);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
